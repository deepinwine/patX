{
  "rule_version": "CN-2026.09",
  "jurisdiction": "CN",
  "notes": "中国专利期限规则集。依据截至2026-09-24的现行法规：2020年修正《专利法》；2023年修订《实施细则》(2024-01-20实施)；《专利审查指南》第84号局令(2026-01-01实施)；《专利优先审查管理办法》第85号局令(2026-09-01实施)。计算底座：起算当天不计入；月/年期限取对应日、无对应日取月末；截止日落在法定休假日顺延至下一工作日。kind=HARD_DEADLINE 为法定硬期限，OPEN_WINDOW 为程序窗口，SLA 为审查内部目标（非申请人期限）。",
  "calc_base": {
    "start_day_excluded": true,
    "corresponding_day_rule": true,
    "holiday_adjustment": true,
    "service_date_rules": {
      "electronic": "进入当事人认可电子系统之日=送达日（不再+15天）",
      "paper_mail": "发文日+15日推定收到，可举证实际收到日",
      "direct": "实际交付日",
      "announcement": "公告日起满1个月视为送达"
    }
  },
